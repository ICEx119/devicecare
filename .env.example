# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้ามแชร์ไฟล์ .env ให้คนอื่น เพราะมี token)

# LINE Developers Console > ช่อง Messaging API > แท็บ Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers Console > แท็บ Basic settings > Channel secret
# จำเป็นสำหรับให้ผู้ใช้เชื่อมต่อ LINE ด้วยรหัส 6 หลัก (ใช้ตรวจว่า webhook มาจาก LINE จริง)
LINE_CHANNEL_SECRET=

# (สำหรับทดสอบบนเครื่องตัวเองเท่านั้น) webhook เข้าถึง localhost ไม่ได้ จึงเชื่อมต่อด้วยรหัสไม่ได้
# ใส่ Your user ID (แท็บ Basic settings) แล้วระบบจะผูก LINE นี้ให้บัญชีแรกที่สมัครในเว็บโดยอัตโนมัติ
LINE_USER_ID=

# เวลาส่งสรุปประจำวัน (รูปแบบ HH:MM ตามเวลาเครื่อง)
NOTIFY_TIME=08:00

# ชื่อผู้ใช้ที่เป็นผู้ดูแลระบบ (เห็นเมนู "ผู้ดูแลระบบ") คั่นหลายคนด้วยจุลภาค เช่น admin,somchai
ADMIN_USERNAMES=

# ลิงก์ของเว็บเมื่อนำขึ้นออนไลน์ เช่น https://devicecare.onrender.com (ใส่ในข้อความ LINE)
APP_URL=

# AI วิเคราะห์อาการ: API key จาก https://console.anthropic.com > API Keys (ขึ้นต้นด้วย sk-ant-)
# ถ้าไม่ใส่ หน้า AI จะแจ้งว่ายังไม่พร้อมใช้งาน ส่วนอื่นของเว็บใช้ได้ตามปกติ
ANTHROPIC_API_KEY=

# (ไม่บังคับ) โมเดลที่ใช้ ค่าเริ่มต้นคือ claude-haiku-5-5 (เร็ว ตอบเฉลี่ยราว 5 วินาที)
# claude-opus-5-5 วิเคราะห์ละเอียดกว่า แต่ใช้ 12–15 วินาที เกินเกณฑ์ 10 วินาทีของแบบประเมิน
AI_MODEL=

# (ไม่บังคับ) บัญชีทดสอบสำหรับผู้ประเมิน: ใส่รหัสผ่านแล้วระบบจะสร้างบัญชี demo พร้อมข้อมูลตัวอย่างตอนเริ่มระบบ
DEMO_USERNAME=demo
DEMO_PASSWORD=
