# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้ามแชร์ไฟล์ .env ให้คนอื่น เพราะมี token)

# LINE Developers Console > ช่อง Messaging API > แท็บ Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers Console > แท็บ Basic settings > Channel secret
# จำเป็นสำหรับให้ผู้ใช้เชื่อมต่อ LINE ด้วยรหัส 6 หลัก (ใช้ตรวจว่า webhook มาจาก LINE จริง)
LINE_CHANNEL_SECRET=

# (สำหรับทดสอบบนเครื่องตัวเองเท่านั้น) webhook เข้าถึง localhost ไม่ได้ จึงเชื่อมต่อด้วยรหัสไม่ได้
# ใส่ Your user ID (แท็บ Basic settings) แล้วระบบจะผูก LINE นี้ให้บัญชีแรกที่สมัครในเว็บโดยอัตโนมัติ
LINE_USER_ID=

# เวลาส่งสรุปประจำวัน (รูปแบบ HH:MM ตามเวลาเครื่อง)
NOTIFY_TIME=08:00

# ลิงก์ของเว็บเมื่อนำขึ้นออนไลน์ เช่น https://devicecare.onrender.com (ใส่ในข้อความ LINE)
APP_URL=
